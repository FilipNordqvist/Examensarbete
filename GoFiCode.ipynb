    "        observed_positions_list.append(observed_positions[i])\n",
    "        total_distance += abs(kf.x[0] - previous_position)\n",
    "        previous_position = kf.x[0]\n",
    "\n",
    "    return kf, total_distance,estimated_positions, observed_positions_list\n"
   ]
